# Скопируй этот файл в .env и заполни значениями из своего проекта Supabase
# (Project Settings -> API). Пока .env нет — приложение работает на
# локальных демо-данных из src/data/seed.js, ничего не сломается.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
